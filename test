#~~~~~~~~~~Population Covariance~~~~~~~~~~~~~~
xj <- c(1,4,5,8)        
yj <- c(12,4,10,7)        
pj <- c(0.3,0.2,0.1,0.4) 
EX  <- sum(xj * pj)               
EY  <- sum(yj * pj)              
EXY <- sum(xj * yj * pj) 
EX2 <- sum(xj^2 *pj) 
EY2 <- sum(yj^2 *pj)
VarX <- EX2 - EX^2 
VarY <- EY2 - EY^2
SDX <- sqrt(VarX)
SDY <- sqrt(VarY)
Cov <- EXY - EX*EY    
Cor <- Cov / (SDX * SDY)
